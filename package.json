{
    "name": "2025seiseisai.com",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "deploy": "node ./scripts/deploy.mjs",
        "dev": "node --env-file=.env ./scripts/prepare.mjs && npm install && prisma generate && opener http://localhost:3000/2025 && node --env-file=.env ./scripts/launch.mjs",
        "build": "prisma generate && next build --turbopack && next-image-export-optimizer",
        "start": "next start",
        "lint": "next lint && stylelint \"src/**/*.(scss|less|css)\" && prettier --check .",
        "format": "next lint --fix && stylelint \"src/**/*.(scss|less|css)\" --fix && prettier --write .",
        "clean": "npx modclean --run",
        "upgrade": "npx ncu -u && npm install",
        "type-check": "prisma generate && tsc --noEmit",
        "postinstall": "patch-package",
        "update-blogs": "node ./scripts/generate-blog-data.mjs",
        "prisma:generate": "prisma generate",
        "prisma:db-pull": "prisma db pull",
        "prisma:db-push": "prisma db push",
        "prisma:studio": "prisma studio"
    },
    "browserslist": [
        "> 0% and not dead"
    ],
    "dependencies": {
        "@next/third-parties": "^15.5.4",
        "@prisma/client": "^6.16.2",
        "embla-carousel-react": "^8.6.0",
        "gray-matter": "^4.0.3",
        "holy-loader": "^2.3.13",
        "lottie-react": "^2.4.1",
        "next": "^15.5.4",
        "next-image-export-optimizer": "^1.19.0",
        "next-mdx-remote": "^5.0.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-tweet": "^3.2.2",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "sass": "^1.93.2",
        "sharp": "^0.34.4",
        "tailwindcss": "^4.1.13",
        "three": "^0.180.0",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@svgr/webpack": "^8.1.0",
        "@tailwindcss/postcss": "^4.1.13",
        "@types/node": "^24",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.180.0",
        "autoprefixer": "^10.4.21",
        "babel-plugin-react-compiler": "^19.1.0-rc.3",
        "eslint": "^9",
        "eslint-config-next": "15.5.4",
        "eslint-plugin-better-tailwindcss": "^3.7.9",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "opener": "^1.5.2",
        "patch-package": "^8.0.0",
        "postcss-flexbugs-fixes": "^5.0.2",
        "postcss-preset-env": "^10.4.0",
        "postinstall-postinstall": "^2.1.0",
        "prettier": "^3.6.2",
        "prettier-plugin-classnames": "^0.8.3",
        "prisma": "^6.16.2",
        "stylelint": "^16.24.0",
        "stylelint-config-recess-order": "^7.3.0",
        "stylelint-config-standard-scss": "^16.0.0",
        "typescript": "^5.9",
        "typescript-plugin-css-modules": "^5.2.0"
    },
    "overrides": {
        "tmp": "0.2.4"
    }
}
